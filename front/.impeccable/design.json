  "narrative": {
    "northStar": "Sala de controle editorial",
    "overview": "Interface de engenharia com leitura editorial: títulos fortes, planos foscos, divisórias finas e conteúdo operacional compacto. Landing e Mola usam papel claro e quente; Admin usa preto e cinzas neutros, conforme a correção explícita do usuário. O laranja identifica ações e seleção.\n\nO personagem Mola preserva o atlas arco-íris original; o movimento elástico Slinky foi integrado ao transporte. Conteúdo, controles e estados permanecem compreensíveis sem depender da animação.",
    "keyCharacteristics": [
      "Papel claro na entrada e no quadro; preto neutro no Admin.",
      "Hierarquia tipográfica forte sobre dados compactos.",
      "Demonstração identificada e ambiente explícito.",
      "Personagem original como comportamento funcional do quadro."
    ],
    "rules": [
      {
        "name": "The Theme Boundary Rule",
        "body": "Preserve preto e cinza neutro no Admin; não propague os verdes de superfície do quadro para o painel. Acentos laranja e alertas quentes continuam semânticos.",
        "section": "colors"
      },
      {
        "name": "The Data Type Rule",
        "body": "Use mono e números tabulares para identificação e medição; preserve sans legível nos relatos e ações.",
        "section": "typography"
      },
      {
        "name": "The Evidence Hierarchy Rule",
        "body": "Separe contexto, ações, indicadores e dados por alinhamento e divisórias; mantenha busca, acompanhamento e detalhes disponíveis no responsivo.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve a separação entre papel claro e Admin preto neutro.",
      "Do mantenha texto e ícone junto dos estados e ambiente explícito.",
      "Do preserve foco visível, rótulos, redução de movimento e rolagem local dos dados.",
      "Do derive novas superfícies dos controles e hierarquias existentes."
    ],
    "donts": [
      "Don't reintroduza verde nos fundos e planos do Admin.",
      "Don't substitua o personagem original por uma ilustração genérica.",
      "Don't apresente dados de demonstração como operação remota comprovada."
    ]
  },
  "interfacePolicy": {
    "environment": "Server env only; no client selector or connection editor.",
    "copy": "Use plain Portuguese: Atividades, Tempo por etapa, Projeto and Procedimentos. Explain results instead of showing hashes, HTTP codes and machine labels."
  }
