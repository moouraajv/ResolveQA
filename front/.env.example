# Escolha apenas aqui a origem dos dados. Reinicie o servidor após alterar.
# demo = exemplos locais; production = serviço real. Sem esta variável, usa production.
RESOLVEQA_MODE=demo

# Endereço público ou gateway do serviço (nunca informe chaves/segredos aqui).
RESOLVEQA_API_URL=https://d2f79ulrlhg51j.cloudfront.net
# IDs retornados por POST /api/cases (ex.: após scripts/seed-backend-cases.mjs).
RESOLVEQA_CASE_IDS=

# Cloud spine: snapshot + SSE no backend ResolveQA (produção real).
RESOLVEQA_SNAPSHOT_PATH=/api/snapshot
RESOLVEQA_EVENTS_PATH=/api/events
RESOLVEQA_PLAYBOOKS_PATH=
